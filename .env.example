# Production credentials. Create a confidential OAuth application in ZITADEL
# and grant it permission to introspect tokens, then fill both values.
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Keep this value secret and stable for the lifetime of the ZITADEL database.
ZITADEL_MASTERKEY=replace-with-a-32-character-masterkey
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=change-me
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL=admin@localhost
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_FIRSTNAME=Admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_LASTNAME=Local